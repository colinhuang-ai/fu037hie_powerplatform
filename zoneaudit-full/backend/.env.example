# ---- Server ----
NODE_ENV=development
PORT=4000
# Browser origin(s) of the web UI (comma separated). Dev: the Vite server. Prod: your public site URL.
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Required in production: at least 32 random chars  (node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
SESSION_SECRET=
SESSION_HOURS=12
# Defaults to true in production. Keep true when served over HTTPS.
COOKIE_SECURE=
# true when behind a reverse proxy / load balancer
TRUST_PROXY=
DATA_DIR=./data

# ---- Dataverse (leave empty to run on built-in mock data) ----
DATAVERSE_URL=https://diencaothe.crm7.dynamics.com
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web) ----
GOOGLE_CLIENT_ID=
# Optional: auto-create unknown Google accounts with this role (auditor | fixer). Empty = admin must pre-register emails.
GOOGLE_AUTO_PROVISION_ROLE=
# Optional: when auto-provisioning, only these email domains (comma separated)
GOOGLE_ALLOWED_DOMAINS=

# ---- First admin (created on first start when there are no users) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
