table SanXuatCaoThe
	lineageTag: 37d452b1-b81f-4cea-92c1-cc7963a4c0a5

	measure 'SP thực tế' = SUM('SanXuatCaoThe'[SL thực tế])
		formatString: #,0
		displayFolder: Số đo
		lineageTag: 76886072-dfc0-4588-afb0-6925365d6263

	measure 'SP mỗi ngày' = DIVIDE([SP thực tế], DISTINCTCOUNT('SanXuatCaoThe'[Ngày]))
		formatString: #,0.0
		displayFolder: Số đo
		lineageTag: f758c888-314c-470d-a200-472a588e4f0f

	measure '% Hoàn thành KH' =
			DIVIDE(
			    CALCULATE(SUM('SanXuatCaoThe'[SL thực tế]), 'SanXuatCaoThe'[Hoàn thành KH] <= 1.5),
			    CALCULATE(SUM('SanXuatCaoThe'[SL kế hoạch]), 'SanXuatCaoThe'[Hoàn thành KH] <= 1.5)
			)
		formatString: 0.0%
		displayFolder: Số đo
		lineageTag: 9325e7fe-0f05-494a-bb9e-3637c85f0870

	measure '% Lỗi' = DIVIDE(SUM('SanXuatCaoThe'[SP lỗi]), SUM('SanXuatCaoThe'[SL thực tế]))
		formatString: 0.00%
		displayFolder: Số đo
		lineageTag: d0b1fbf9-429e-4e48-83b0-3796b15ff9bc

	measure '% Sẵn sàng máy' = DIVIDE(SUM('SanXuatCaoThe'[Giờ vận hành]), SUM('SanXuatCaoThe'[Giờ vận hành]) + SUM('SanXuatCaoThe'[Giờ dừng máy]))
		formatString: 0.0%
		displayFolder: Số đo
		lineageTag: 0f102d75-cbc5-4227-bde9-6164e9aac7f5

	measure 'SP trên giờ công' = DIVIDE([SP thực tế], SUM('SanXuatCaoThe'[Giờ công]))
		formatString: 0.00
		displayFolder: Số đo
		lineageTag: 8d188a79-4f17-4bcf-a50b-76ca658da80d

	measure 'kWh trên SP' = DIVIDE(SUM('SanXuatCaoThe'[Điện năng (kWh)]), [SP thực tế])
		formatString: 0.0
		displayFolder: Số đo
		lineageTag: 39daf3b1-adc1-4a91-8fc9-97bfbd58b286

	measure 'KPI SP thực tế' =
			VAR m = MAX('SanXuatCaoThe'[Tháng số])
			RETURN CALCULATE([SP thực tế], 'SanXuatCaoThe'[Tháng số] = m)
		formatString: #,0
		displayFolder: Số đo
		lineageTag: e9d7fe98-dd7a-42ee-b2af-cc629d392c30

	measure 'Δ SP thực tế' =
			VAR m = MAX('SanXuatCaoThe'[Tháng số])
			VAR cur = CALCULATE([SP mỗi ngày], 'SanXuatCaoThe'[Tháng số] = m)
			VAR prv = CALCULATE([SP mỗi ngày], REMOVEFILTERS('SanXuatCaoThe'[Tháng]), 'SanXuatCaoThe'[Tháng số] = m - 1)
			RETURN IF(ISBLANK(prv), BLANK(), DIVIDE(cur, prv) - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Số đo
		lineageTag: 7486f66c-51e1-4c09-99fa-a2a683b6a2bc

	measure 'Δ text SP thực tế' =
			VAR m = MAX('SanXuatCaoThe'[Tháng số])
			VAR d = [Δ SP thực tế]
			RETURN IF(ISBLANK(d), BLANK(), IF(d >= 0, "▲ +", "▼ −") & FORMAT(ABS(d), "0.0%", "vi-VN") & "/ngày so với T" & (m - 1))
		displayFolder: Số đo
		lineageTag: 4210e448-1aa0-4db4-9677-a943f14bdb17

	measure 'Δ màu SP thực tế' =
			VAR d = [Δ SP thực tế]
			RETURN IF(d >= 0, "#1E8E5A", "#C0392B")
		displayFolder: Số đo
		lineageTag: 27ed59cb-b86e-476d-b893-1367e72e4c4d

